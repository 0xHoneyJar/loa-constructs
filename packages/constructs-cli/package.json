{
  "name": "@loa-constructs/capability-cli",
  "version": "0.1.0",
  "private": true,
  "description": "constructs — the veve'd navigation & stationing CLI for the constructs network. Zero runtime dependencies; deterministic JSON; Finn-sandbox compatible.",
  "type": "module",
  "bin": {
    "constructs": "./bin/constructs.mjs"
  },
  "exports": {
    ".": "./lib/contract.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:vectors": "node test/vectors/run-vectors.mjs",
    "test:all": "node --test test/*.test.mjs && node test/vectors/run-vectors.mjs"
  },
  "files": [
    "bin",
    "lib",
    "schemas",
    "veve.json"
  ],
