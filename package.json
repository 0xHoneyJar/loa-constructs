{
  "name": "loa-constructs",
  "private": true,
  "version": "1.5.0",
  "description": "SaaS platform for distributing, licensing, and monetizing AI agent constructs",
  "packageManager": "bun@1.2.7",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "discover": "tsx scripts/discover-constructs.ts",
    "seed": "tsx scripts/seed-forge-packs.ts",
    "seed:auto": "tsx scripts/seed-forge-packs.ts --auto-discover",
    "constructs": "tsx packages/loa-registry/bin/constructs.ts"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "next": "^14.2.0",
    "prettier": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
