{
  "name": "loa-constructs",
  "private": true,
  "version": "1.5.0",
  "description": "SaaS platform for distributing, licensing, and monetizing AI agent constructs. NB: this `version` field is the monorepo-package version domain (historical bun/turbo workspace tag); the canonical construct-registry release version is shown in README.md badge + CHANGELOG.md and on GitHub Releases (currently v2.41.0). See cycle-0 README version-surface map.",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "discover": "tsx scripts/discover-constructs.ts",
    "seed": "tsx scripts/seed-forge-packs.ts",
    "seed:auto": "tsx scripts/seed-forge-packs.ts --auto-discover",
    "populate": "scripts/populate-global-store.sh",
    "populate:dry": "scripts/populate-global-store.sh --dry-run",
    "seed:full": "tsx scripts/seed-forge-packs.ts --auto-discover && scripts/populate-global-store.sh",
    "constructs": "tsx packages/loa-registry/bin/constructs.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "0.28.0",
    "prettier": "^3.2.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "esbuild": "0.28.0"
  }
}
