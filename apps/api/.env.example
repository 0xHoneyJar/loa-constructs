# Loa Constructs API — Environment Variables (cycle-012 libSQL)
# @see sdd.md §6.5 Secrets management
#
# Copy to .env and fill in values.

# ============================================================
# Required
# ============================================================

# --- Database (libSQL) --- [REQUIRED]
# Turso managed edge URL in production, local file in development.
# @see sdd.md §4 Technology stack
#
# Production: libsql://<db-name>-<org-slug>.turso.io
# Local dev:  file:./local.db (default if unset)
TURSO_DATABASE_URL=file:./local.db

# Turso auth token — required for managed edge, unused for file:// dev.
# Generate via: turso db tokens create <db-name>
# TURSO_AUTH_TOKEN=

# --- Server --- [REQUIRED in production]
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================================================
# Optional
# ============================================================

# --- Operational admin token --- [OPTIONAL]
# Shared secret for admin endpoints (POST /v1/admin/discover).
# @see sdd.md §6.1 Authentication
# Generate: echo "cto_$(openssl rand -hex 32)"
# CONSTRUCTS_ADMIN_TOKEN=cto_your_random_hex_here

# --- GitHub integration --- [OPTIONAL]
# Token used by /v1/admin/discover to enumerate construct repos.
# Repo: public read scope sufficient.
# GITHUB_TOKEN=ghp_your_token_here

# --- GitHub org for construct discovery --- [OPTIONAL]
# Default: 0xHoneyJar
# CONSTRUCTS_ORG=0xHoneyJar

# --- Monitoring --- [OPTIONAL]
# Used for error tracking; fallback: pino stdout only.
# SENTRY_DSN=https://...@sentry.io/...
