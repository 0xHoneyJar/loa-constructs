# Site URL for metadata
NEXT_PUBLIC_SITE_URL=https://constructs.loa.dev

# Constructs API (optional - defaults to production)
CONSTRUCTS_API_URL=https://api.constructs.network/v1

# --- Convex ---
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_URL=https://your-deployment.convex.cloud

# --- Signals Pipeline (cycle-044) ---
# Shared secret between route handlers and Convex actions
CONVEX_WRITE_KEY=
# API key for the explorer's own feedback widget
SIGNALS_API_KEY=
# Linear integration (set in Convex dashboard env vars)
LINEAR_WEBHOOK_SECRET=
# Required in Convex dashboard for Linear issue creation:
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_PRODUCT=<team-id>
# LINEAR_TEAM_INFRASTRUCTURE=<team-id>
# Required in Convex dashboard for Discord alerting:
# DISCORD_SIGNALS_WEBHOOK_URL=https://discord.com/api/webhooks/...
