{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "loa.network.legacy-domain-contract.v0",
  "title": "LegacyDomainContract",
  "description": "Compatibility-tier contract for legacy packs that opt into bounded-context mode without a full domain block in the pack manifest. Lives at .claude/data/legacy-domain-contracts/<slug>.yaml. Generated as a starter via legacy-contract-bootstrap.sh, then operator-curated. construct-validate.sh rejects starter-only contracts (must have non-empty out_of_domain and at least one invariant) per SDD §2.4 / S0-T3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_tier",
    "construct_slug",
    "domain",
    "streams",
    "capabilities",
    "context_policy",
    "out_of_domain",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "loa.network.legacy-domain-contract.v0"
    },
    "validation_tier": {
      "type": "string",
      "const": "compatibility",
      "description": "Marker that this contract participates in compatibility-tier validation. Strict packs use the manifest domain block directly; advisory packs have no contract."
    },
    "construct_slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Pack the contract applies to. MUST match the manifest slug; mismatch → [LEGACY-CONTRACT-SLUG-MISMATCH]."
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance of the starter generation. Set by legacy-contract-bootstrap.sh; operator MAY edit but should preserve.",
      "properties": {
        "manifest_path": { "type": "string", "maxLength": 400 },
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "bootstrap_version": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "supporting": {
          "type": "array",
          "items": { "type": "string", "maxLength": 80 },
          "maxItems": 20
        },
        "ubiquitous_language": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 },
          "maxItems": 50,
          "description": "Optional in compatibility tier; required in strict tier."
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes"],
      "description": "Stream contract per Typed-Streams Protocol. Bootstrap heuristic populates from manifest's composes_with; operator refines.",
      "properties": {
        "reads": {
          "type": "array",
          "items": { "$ref": "#/$defs/StreamSpec" },
          "maxItems": 50
        },
        "writes": {
          "type": "array",
          "items": { "$ref": "#/$defs/StreamSpec" },
          "maxItems": 50
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared capability surface (filesystem, network, env, mcp_tools).",
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reads": {
              "type": "array",
              "items": { "type": "string", "maxLength": 400 },
              "maxItems": 100
            },
            "writes": {
              "type": "array",
              "items": { "type": "string", "maxLength": 400 },
              "maxItems": 100
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "egress": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.-]+:[0-9]+$"
              },
              "maxItems": 50
            }
          }
        },
        "env": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "maxItems": 100
        },
        "mcp_tools": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "maxItems": 50
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default context policy applied when this pack runs in compatibility tier. Compositions MAY override per-stage; this provides the floor.",
      "properties": {
        "include_prior_transcript": { "type": "boolean" },
        "include_unread_stage_outputs": { "type": "boolean" },
        "include_unlisted_grimoires": { "type": "boolean" },
        "llm_session_strategy": { "type": "string", "enum": ["fresh", "continue"] }
      }
    },
    "out_of_domain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      },
      "minItems": 1,
      "maxItems": 50,
      "description": "Statements about what this pack DOES NOT do. SDD §2.4: starter has empty array — validator rejects until operator populates with at least one entry."
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      },
      "minItems": 1,
      "maxItems": 30,
      "description": "Domain invariants the pack asserts. SDD §2.4: starter has empty array — validator rejects until operator populates with at least one entry."
    },
    "operator_signoff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Curation provenance. construct-validate.sh prefers contracts with operator_signoff set; pure-bootstrap contracts (no signoff) only pass when out_of_domain and invariants are populated AND a signoff is present here.",
      "required": ["operator", "completed_at"],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Operator handle from OPERATORS.md."
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "StreamSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Signal", "Verdict", "Artifact", "Intent", "OperatorModel"]
        },
        "schema_id": {
          "type": "string",
          "pattern": "^loa\\.stream\\.[A-Za-z]+\\.v[0-9]+$",
          "maxLength": 80
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string", "maxLength": 80 }
          }
        }
      }
    }
  }
}
